# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional comma-separated fallback models if primary model fails
# GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
